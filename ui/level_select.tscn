[gd_scene format=3]

[ext_resource type="Script" path="res://ui/level_select.gd" id="1_select"]
[ext_resource type="PackedScene" path="res://ui/background.tscn" id="2_bg"]
[ext_resource type="Texture2D" path="res://assets/ui/back.png" id="3_back"]

[node name="LevelSelect" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_select")

[node name="Background" parent="." instance=ExtResource("2_bg")]
layout_mode = 1

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 32

[node name="Rows" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 32

[node name="Header" type="HBoxContainer" parent="Margin/Rows"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="BackButton" type="Button" parent="Margin/Rows/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 96)
layout_mode = 2
theme_type_variation = &"IconButton"
icon = ExtResource("3_back")
icon_alignment = 1
expand_icon = true

[node name="Title" type="Label" parent="Margin/Rows/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeaderLabel"
theme_override_font_sizes/font_size = 64
text = "Levels"

[node name="TotalStars" type="Label" parent="Margin/Rows/Header"]
auto_translate_mode = 2
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "0 / 30"
vertical_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="Margin/Rows"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Grid" type="GridContainer" parent="Margin/Rows/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 6
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 24
columns = 3
