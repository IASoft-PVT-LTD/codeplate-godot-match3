[gd_scene format=3]

[ext_resource type="Script" path="res://ui/title.gd" id="1_title"]
[ext_resource type="PackedScene" path="res://ui/background.tscn" id="2_bg"]

[node name="Title" type="Control"]
anchors_preset = 15
