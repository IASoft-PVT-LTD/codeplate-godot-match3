[gd_scene format=3]

[ext_resource type="Script" path="res://game/level.gd" id="1_level"]
[ext_resource type="PackedScene" path="res://ui/background.tscn" id="2_bg"]
[ext_resource type="PackedScene" path="res://game/hud.tscn" id="3_hud"]
[ext_resource type="Script" path="res://game/board_view.gd" id="4_board"]
[ext_resource type="Texture2D" path="res://assets/ui/pause.png" id="5_pause"]
[ext_resource type="PackedScene" path="res://ui/pause_menu.tscn" id="6_pause_menu"]
[ext_resource type="PackedScene" path="res://game/result_panel.tscn" id="7_result"]

[node name="Level" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_level")

[node name="Background" parent="." instance=ExtResource("2_bg")]
layout_mode = 1

[node name="Hud" parent="." instance=ExtResource("3_hud")]
unique_name_in_owner = true
layout_mode = 1

[node name="BoardView" type="Node2D" parent="."]
unique_name_in_owner = true
script = ExtResource("4_board")

[node name="BottomBar" type="MarginContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -124.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 28

[node name="Row" type="HBoxContainer" parent="BottomBar"]
layout_mode = 2
mouse_filter = 2

[node name="PauseButton" type="Button" parent="BottomBar/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 96)
layout_mode = 2
theme_type_variation = &"IconButton"
icon = ExtResource("5_pause")
icon_alignment = 1
expand_icon = true

[node name="PauseMenu" parent="." instance=ExtResource("6_pause_menu")]
unique_name_in_owner = true
layout_mode = 1

[node name="ResultPanel" parent="." instance=ExtResource("7_result")]
unique_name_in_owner = true
layout_mode = 1
