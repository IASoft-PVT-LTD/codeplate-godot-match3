{
  "$schema": "https://codeplate.io/schema/codeplate-0.json",
  "spec": 0,
  "id": "godot-match3",
  "name": "Godot Match 3",
  "version": "1.3.4",
  "kind": "game",
  "summary": "A complete, polished match-3 puzzle game in Godot 4: specials, combos, cascades, level goals, stars and menus.",
  "tags": [
    "godot",
    "gdscript",
    "puzzle",
    "match-3",
    "mobile",
    "2d"
  ],
  "stack": [
    {
      "name": "godot",
      "version": "4.7.2"
    }
  ],
  "checks": {
    "command": "godot --headless --path . --import && godot --headless --path . --script res://addons/codeplate/checks/run.gd",
    "requires": [
      "godot"
    ]
  },
  "license": "CodePlate-Free-1.3",
  "tier": "free",
  "media": [
    "docs/media/title.png",
    "docs/media/level.png",
    "docs/media/action.png",
    "docs/media/levels.png"
  ]
}
